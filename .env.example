# Database Configuration (PostgreSQL by default, SQLite for quick local test)
# PostgreSQL: postgresql://USER:PASSWORD@HOST:5432/DB_NAME?schema=public
# SQLite: file:./dev.db
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jangkriknet?schema=public"

# Authentication & Security
JWT_SECRET="jangkriknet-super-secure-jwt-secret-key-2026-very-long"

# Application URL
APP_URL="http://localhost:3000"

# Upload Directory (relative to project root)
UPLOAD_DIR="./public/uploads"

# WhatsApp Business Order Number (e.g., 6281234567890)
WHATSAPP_NUMBER="6281234567890"

# Node Environment
NODE_ENV="development"
